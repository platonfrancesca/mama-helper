### Create reminder
POST http://localhost:8080/api/reminders
Content-Type: application/json

{
  "title": "Bath time",
  "description": "Give baby a bath",
  "time": "2026-09-29T19:00:00"
}

### Create child
POST http://localhost:8080/api/child
Content-Type: application/json

{
  "name": "Maria",
  "dateOfBirth": "2026-01-01"
}

### Update child by ID
PUT http://localhost:8080/api/child/1
Content-Type: application/json

{
  "name": "Maria Elena",
  "dateOfBirth": "2026-01-02"
}

### Update missing child (expect 404)
PUT http://localhost:8080/api/child/999
Content-Type: application/json

{
  "name": "Ana",
  "dateOfBirth": "2025-05-05"
}

### Delete child by ID (also deletes its reminders and notifications)
DELETE http://localhost:8080/api/child/1

### Test invalid child (expect 400 with field errors)
POST http://localhost:8080/api/child
Content-Type: application/json

{
  "name": "",
  "dateOfBirth": "2026-01-01"
}

### Create reminder for a child
POST http://localhost:8080/api/reminders
Content-Type: application/json

{
  "title": "Bath time",
  "description": "Give baby a bath",
  "time": "2026-11-05T15:10:00",
  "childId": 1
}

### Test invalid reminder
POST http://localhost:8080/api/reminders
Content-Type: application/json

{
  "title": "",
  "description": "This reminder should not be created",
  "time": "2026-09-29T19:00:00"
}

### Test reminder with invalid time format (expect 400)
POST http://localhost:8080/api/reminders
Content-Type: application/json

{
  "title": "Bath time",
  "time": "tomorrow",
  "childId": 1
}

### Create daily reminder (vitamins every day at 8:00, no end date)
POST http://localhost:8080/api/reminders
Content-Type: application/json

{
  "title": "Vitamins",
  "time": "2026-12-01T08:00:00",
  "childId": 1,
  "repeat": "DAILY"
}

### Create weekly reminder (bath on Monday and Thursday until 31 March; time moves to the first chosen day)
POST http://localhost:8080/api/reminders
Content-Type: application/json

{
  "title": "Bath time",
  "time": "2026-12-01T19:00:00",
  "childId": 1,
  "repeat": "WEEKLY",
  "days": ["MONDAY", "THURSDAY"],
  "endDate": "2027-03-31"
}

### Test weekly reminder without days (expect 400)
POST http://localhost:8080/api/reminders
Content-Type: application/json

{
  "title": "Bath time",
  "time": "2026-12-01T19:00:00",
  "childId": 1,
  "repeat": "WEEKLY"
}

### Test daily reminder with days (expect 400)
POST http://localhost:8080/api/reminders
Content-Type: application/json

{
  "title": "Vitamins",
  "time": "2026-12-01T08:00:00",
  "childId": 1,
  "repeat": "DAILY",
  "days": ["MONDAY"]
}

### Test end date before the first occurrence (expect 400)
POST http://localhost:8080/api/reminders
Content-Type: application/json

{
  "title": "Medicine",
  "time": "2026-12-01T08:00:00",
  "childId": 1,
  "repeat": "DAILY",
  "endDate": "2026-11-30"
}

### Get all reminders
GET http://localhost:8080/api/reminders

### Get reminder by ID
GET http://localhost:8080/api/reminders/1

### Update a reminder by ID
PUT http://localhost:8080/api/reminders/1
Content-Type: application/json

{
  "title": "Bath time",
  "description": "Give baby a bath + pyjamas",
  "time": "2026-10-14T19:30:00"
}

### Delete reminder by ID
DELETE http://localhost:8080/api/reminders/1

### Get all notifications
GET http://localhost:8080/api/notifications

### Get notification by ID
GET http://localhost:8080/api/notifications/1

### Mark notification as read
PATCH http://localhost:8080/api/notifications/1/read

### Delete notification by ID
DELETE http://localhost:8080/api/notifications/1